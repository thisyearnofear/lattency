#!/usr/bin/env bash
# deface wrapper for the scan-worker contract.
# The worker calls:  deface <framesDir> -o <outDir> --thresh 0.2 ...
# Real deface accepts a directory input but a single -o path, which would
# overwrite every frame to one file. This wrapper expands a directory input
# into per-file invocations that preserve filenames inside the output dir.
# @DEFACE_REAL@ is baked to the pip-installed entrypoint at image build time.
set -euo pipefail
REAL="@DEFACE_REAL@"

input=""
outdir=""
extra=()
while [ $# -gt 0 ]; do
  case "$1" in
    -o|--output)
      outdir="$2"; shift 2 ;;
    --output=*)
      outdir="${1#--output=}"; shift ;;
    -o?*)
      outdir="${1#-o}"; shift ;;
    -*)
      extra+=("$1"); shift ;;
    *)
      if [ -z "$input" ]; then input="$1"; else extra+=("$1"); fi
      shift ;;
  esac
done

if [ -n "$input" ] && [ -d "$input" ] && [ -n "$outdir" ]; then
  mkdir -p "$outdir"
  rc=0
  for f in "$input"/*; do
    [ -f "$f" ] || continue
    base="$(basename "$f")"
    "$REAL" "$f" -o "$outdir/$base" "${extra[@]}" || rc=1
  done
  exit $rc
fi

# Non-directory usage: pass through untouched.
exec "$REAL" ${input:+"$input"} ${outdir:+-o "$outdir"} "${extra[@]}"
